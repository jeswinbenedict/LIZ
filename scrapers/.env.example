# Environment for the Python scraper and maintenance scripts
# (python -m liz_scraper ...). Export these in your shell or load them with
# your tool of choice. Copy to scrapers/.env (git-ignored).

# Direct database writes (GitHub Actions and maintenance scripts). The
# service-role key bypasses row-level security: keep it secret.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Alternative for machines that should not hold the service-role key: send
# rows through the scraper-ingest Edge Function instead (n8n/README.md).
LIZ_INGEST_KEY=

# Optional: raises GitHub's search rate limit for liz_scraper.signals.
GITHUB_TOKEN=

# Optional: the Ask Liz evaluation (liz_scraper.eval_ask).
SUPABASE_ANON_KEY=
ASK_EVAL_KEY=
