{
  "name": "Liz — Content Ingestion",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Every 6 hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-200, 300]
    },
    {
      "parameters": {
        "command": "cd /data/liz/scrapers && python -m liz_scraper --limit 20 --status pending"
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "BeautifulSoup scraper",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [40, 180],
      "notesInFlow": true,
      "notes": "Needs SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY in the n8n container env."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_FUNCTIONS_URL }}/fetch-tools",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "GitHub tools",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [40, 320]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_FUNCTIONS_URL }}/fetch-news",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "Tech news",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [40, 460]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/rpc/refresh_trend_scores",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "a1b2c3d4-0005-4000-8000-000000000005",
      "name": "Refresh trend scores",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [320, 320],
      "notesInFlow": true,
      "notes": "Recomputes the Rising Early ranking after new rows land."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_FUNCTIONS_URL }}/embed-tools",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"limit\": 200}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "a1b2c3d4-0006-4000-8000-000000000006",
      "name": "Embed new tools",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [560, 320],
      "notesInFlow": true,
      "notes": "A tool without an embedding cannot be found by Ask Liz."
    }
  ],
  "connections": {
    "Every 6 hours": {
      "main": [
        [
          {
            "node": "BeautifulSoup scraper",
            "type": "main",
            "index": 0
          },
          {
            "node": "GitHub tools",
            "type": "main",
            "index": 0
          },
          {
            "node": "Tech news",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GitHub tools": {
      "main": [
        [
          {
            "node": "Refresh trend scores",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Refresh trend scores": {
      "main": [
        [
          {
            "node": "Embed new tools",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "tags": []
}
