# Edge Function secrets, for `supabase functions serve --env-file
# supabase/functions/.env`. In production set them with
#   supabase secrets set NAME=value
# Copy to supabase/functions/.env (git-ignored). These are server secrets:
# never commit them and never pass them to the Flutter build.
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by Supabase itself
# in deployed functions and by `supabase start` locally.

# OpenAI-compatible chat endpoint for summaries and Repository Analyzer
# answers. Groq's free tier is the default (console.groq.com -> API Keys).
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=

# Optional second provider, used when the first fails or refuses its key.
AI_FALLBACK_API_KEY=
AI_FALLBACK_BASE_URL=
AI_FALLBACK_MODEL=

# Firebase Admin SDK service account, as one line of JSON. Used by
# send-notification, firebase-session and delete-account (docs/AUTH.md).
FIREBASE_SERVICE_ACCOUNT=

# Shared key the home scraper sends to scraper-ingest (n8n/README.md).
INGEST_KEY=

# Optional: lets the Ask Liz evaluation (scrapers/liz_scraper/eval_ask.py)
# skip the rate limit.
ASK_EVAL_KEY=
