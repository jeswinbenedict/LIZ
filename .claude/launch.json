{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "liz-web-supabase",
      "runtimeExecutable": "flutter",
      "runtimeArgs": [
        "run",
        "-d",
        "web-server",
        "--web-port",
        "8099",
        "--web-hostname",
        "localhost",
        "--dart-define-from-file=.env"
      ],
      "port": 8099,
      "url": "http://localhost:8099"
    },
    {
      "name": "liz-web-release",
      "runtimeExecutable": "flutter",
      "runtimeArgs": [
        "run",
        "--release",
        "-d",
        "web-server",
        "--web-port",
        "8100",
        "--web-hostname",
        "localhost",
        "--dart-define-from-file=.env"
      ],
      "port": 8100,
      "url": "http://localhost:8100"
    },
    {
      "name": "liz-web-demo",
      "runtimeExecutable": "flutter",
      "runtimeArgs": [
        "run",
        "-d",
        "web-server",
        "--web-port",
        "8101",
        "--web-hostname",
        "localhost"
      ],
      "port": 8101,
      "url": "http://localhost:8101"
    },
    {
      "name": "liz-web-wasm",
      "runtimeExecutable": "flutter",
      "runtimeArgs": [
        "run",
        "--release",
        "--wasm",
        "-d",
        "web-server",
        "--web-port",
        "8102",
        "--web-hostname",
        "localhost",
        "--dart-define-from-file=.env"
      ],
      "port": 8102,
      "url": "http://localhost:8102"
    }
  ]
}
