# Liz web app: build-time values, read with
#   flutter run -d chrome --dart-define-from-file=.env
# Copy this file to .env (git-ignored) and fill in your own project.
#
# Every value here is compiled into the public web bundle, so only public,
# client-side values belong in this file. NEVER put the Supabase service-role
# key, the database password or any AI provider key here: those are server
# secrets (supabase/functions/.env.example, scrapers/.env.example).
#
# Leave SUPABASE_URL and SUPABASE_ANON_KEY empty, or don't create .env at
# all, and the app runs on its bundled demo data with a mock backend.

# Supabase project URL: Dashboard -> Project Settings -> API.
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon (public) key. Public by design: every table is protected by
# row-level security (docs/SECURITY.md).
SUPABASE_ANON_KEY=your-anon-key

# Optional: Web Push certificate public key from Firebase Console ->
# Project settings -> Cloud Messaging (docs/FCM_SETUP.md). Without it,
# browser notifications are off.
FCM_VAPID_KEY=

# Optional: a contact address shown in the privacy policy and terms.
LEGAL_CONTACT=
